[Unit]
Description=Leekha Node Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/server/Leekha/backend
ExecStart=/root/server/Leekha/backend/start.sh
Restart=on-failure
Environment=NODE_ENV=production
SyslogIdentifier=leekha-server

[Install]
WantedBy=multi-user.target
